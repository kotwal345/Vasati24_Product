@model List<ActivityLogItemViewModel>
@{
    ViewData["Title"] = "Activity";
}

<div class="page-header">
    <div>
        <span class="page-eyebrow">Vasati24</span>
        <h1>Activity</h1>
        <p class="page-subtitle">The last 100 tracked actions across every society, newest first.</p>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="panel">
        <div class="empty-state">
            @Icons.Render("file-text")
            <h3>No activity yet</h3>
            <p>Actions like creating or deactivating a society will show up here.</p>
        </div>
    </div>
}
else
{
    <div class="table-panel">
        <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>When</th>
                    <th>Society</th>
                    <th>Action</th>
                    <th>Details</th>
                    <th>By</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Model)
                {
                    <tr>
                        <td>@log.ChangedDate.ToLocalTime().ToString("dd-MMM-yyyy HH:mm")</td>
                        <td>@log.SocietyName</td>
                        <td><span class="badge bg-secondary">@log.TableName: @log.Action</span></td>
                        <td>@(log.NewValue ?? "—")</td>
                        <td>@(log.ChangedBy ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    </div>
}
