@model List<UserListItemViewModel>
@{
    ViewData["Title"] = "Logins";
}

<div class="page-header">
    <div>
        <span class="page-eyebrow">सभासद यादी</span>
        <h1>Logins</h1>
        <p class="page-subtitle">Everyone with a login to this society's account.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">@Icons.Render("plus", "icon-sm")Add Member Login</a>
</div>

@if (Model.Count == 0)
{
    <div class="panel">
        <div class="empty-state">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /></svg>
            <h3>No logins yet</h3>
            <p>Add a login so a member can view their own records.</p>
            <a asp-action="Create" class="btn btn-primary mt-2">@Icons.Render("plus", "icon-sm")Add Member Login</a>
        </div>
    </div>
}
else
{
    <div class="table-panel">
        <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td>@u.Email</td>
                        <td><span class="badge bg-secondary">@u.Role</span></td>
                        <td>
                            @if (u.IsLockedOut)
                            {
                                <span class="badge bg-secondary">Deactivated</span>
                            }
                            else if (u.MustChangePassword)
                            {
                                <span class="badge bg-warning text-dark">Password not yet set</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Active</span>
                            }
                        </td>
                        <td class="text-end">
                            @if (u.Role == AppRoles.Member)
                            {
                                @if (u.IsLockedOut)
                                {
                                    <form asp-action="Reactivate" asp-route-id="@u.Id" method="post" data-disable-on-submit class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-primary">Reactivate</button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="Deactivate" asp-route-id="@u.Id" method="post" data-disable-on-submit class="d-inline"
                                          onsubmit="return confirm('Deactivate @u.Email? They will no longer be able to log in.');">
                                        <button type="submit" class="btn btn-sm btn-outline-secondary">Deactivate</button>
                                    </form>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    </div>
}
